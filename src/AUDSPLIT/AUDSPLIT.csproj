<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Audsplit</RootNamespace>
    <AssemblyName>AUDSPLIT</AssemblyName>
    <ApplicationIcon>Assets\audsplit.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>AUDSPLIT</Product>
    <Description>Per-app audio output routing for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\audsplit-logo.png" />
  </ItemGroup>

</Project>
